  ellipse(randomNumber(20,380),randomNumber(20,380),2,2);
  //ellipse(randomNumber(20,380),randomNumber(20,380),2,2);
  //ellipse(randomNumber(20,380),randomNumber(20,380),1,1);
}

// displays na tela (vida e score)
function displayBoard() {

  if (vida == 2) {
    vida3.visible = false;
  }
  
  if (vida == 1) {
    vida2.visible = false;
    vida3.visible = false;
  }
  
  textSize(20);
  text("Score: " + score, 320, 10, 100, 100);
  drawSprites();
}

