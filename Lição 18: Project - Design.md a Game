// Fundo do jogo
function fundo() {
  background("black");
  terra.setAnimation("earth_1");
  terra.rotationSpeed = 1.8;
  
  fill("white");
  stroke("white");
  strokeWeight(1);
  //ellipse(randomNumber(20,380),randomNumber(20,380),4,4);
