// Funcao quen roda o jogo em 30 FPS
function draw() {
  // Se score >= 10 o jogador ganha e muda o background
  if (score >= 10) {
    fundoGanhou();
  }
  
  // Se a vida do jogador cai abaixo de, ele perde e muda o background
  else if (vida <= 0) {
    fundoPerdeu();
  }
  
  // Backgorund normal do jogo
  else {
    fundo();
    displayBoard();
    animacao();
    interaveis();
    movimentoNave();
    arma();
    
    //tirao();
  }

  // update sprites
  

  
  drawSprites();
}

