  estrela.setAnimation("star2_1");
  regen.setAnimation("gameplayobject_health_1");
  vida1.setAnimation("gameplayobject_health_1");
  vida2.setAnimation("gameplayobject_health_1");
  vida3.setAnimation("gameplayobject_health_1");
  pedra.setAnimation("ore_coal_1");
  especial.setAnimation("powerupBlue_bolt_1");
  
  // interativos ativos: naves, aliens e explosao
  verde1.setAnimation("retroaliens_10_1");
  verde2.setAnimation("retroaliens_17_1");
  azul1.setAnimation("retroaliens_14_1");
  azul2.setAnimation("retroaliens_15_1");
  nave.setAnimation("spacebattle_06_1");
  explosao.setAnimation("burst18_1");
}

// Adicionando as interacoes entre os objetos
function interaveis() {
  
  if (nave.isTouching(estrela)) {
    score = score + 1;
    estrela.x = randomGaussian(200,100);
    estrela.y = randomNumber(-100,-30);
  }
  
  if (estrela.y > 415) {
    estrela.x = randomGaussian(200,140);
    estrela.y = randomNumber(-100,-30);
  }
  
  if (nave.isTouching(regen)) {
    vida = vida + 1;
    if (vida == 2) {
      vida2.visible = true;
    }
    if (vida == 3) {
      vida3.visible = true;
    }
    regen.x = randomGaussian(200,240);
    regen.y = randomNumber(-120,-100);
  }
  
  if (regen.y > 415) {
    regen.x = randomGaussian(200,240);
    regen.y = randomNumber(-100,-30);
  }
  
  if (nave.isTouching(pedra) || pedra.y > 415) {
    vida = vida - 1;
    pedra.y = randomNumber(-100,-30);
    pedra.x = randomNumber(30,370);
  }
  
  if (nave.isTouching(verde1) || verde1.y > 415) {
    vida = vida - 1;
    verde1.y = randomNumber(-100,-30);
    verde1.x = randomNumber(30,370);
  }
  
  if (nave.isTouching(verde2) || verde2.y > 415) {
    vida = vida - 1;
    verde2.y = randomNumber(-100,-30);
    verde2.x = randomNumber(30,370);
  }
  
  if (nave.isTouching(azul1) || azul1.y > 415) {
    vida = vida - 1;
    azul1.y = randomNumber(-100,-30);
    azul1.x = randomNumber(30,370);
  }
  
  if (nave.isTouching(azul2) || azul2.y > 415) {
    vida = vida - 1;
    azul2.y = randomNumber(-100,-30);
    azul2.x = randomNumber(30,370);
  }
  
}

// Movimento do player (nave)
function movimentoNave() {
  
  if (keyDown("up")) {
    nave.y = nave.y -7;
  }
  
  if (keyDown("down")) {
    nave.y = nave.y + 7;
  }
  
  if (keyDown("right")) {
    nave.x = nave.x + 7;
  }
  
  if (keyDown("left")) {
    nave.x = nave.x - 7;
  }
  
}

// Funcionamento da arma da nave
// e interacoes com objetos
function arma() {
  
  if (tiro.y <= -5){
    tiro.y = nave.y;
    tiro.x = nave.x;
  }
  
  if (tiro.isTouching(pedra)) {
    tiro.y = nave.y;
    tiro.x = nave.x;
    pedra.y = randomNumber(-100,-30);
    pedra.x = randomNumber(30,370);
  }
  
  if (tiro.isTouching(verde1)) {
    tiro.y = nave.y;
    tiro.x = nave.x;
    verde1.y = randomNumber(-100,-30);
    verde1.x = randomNumber(30,370);
  }
  
  if (tiro.isTouching(verde2)) {
    tiro.y = nave.y;
    tiro.x = nave.x;
    verde2.y = randomNumber(-100,-30);
    verde2.x = randomNumber(30,370);
  }
  
  if (tiro.isTouching(azul1)) {
    tiro.y = nave.y;
    tiro.x = nave.x;
    azul1.y = randomNumber(-100,-30);
    azul1.x = randomNumber(30,370);
  }
  
  if (tiro.isTouching(azul2)) {
    tiro.y = nave.y;
    tiro.x = nave.x;
    azul2.y = randomNumber(-100,-30);
    azul2.x = randomNumber(30,370);
  }
  
}

